<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred to a new device.

  The signing key lives in the Keystore and is not exportable anyway, so a
  restored backup could never sign a command. Copying the session tokens and
  the pairing record without it would produce an app that looks paired and
  cannot do anything - worse than asking the user to pair again, which takes
  thirty seconds.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
